from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.chrome.service import Service
from webdriver_manager.chrome import ChromeDriverManager
import time

service = Service(ChromeDriverManager().install())
driver = webdriver.Chrome(service=service)

try:
    driver.get('https://qiita.com/advent-calendar/2016/crawler')
    time.sleep(4) 

    # カレンダーの「マス（td）」を上から順番に25個分取得する
    # 現在のQiitaの仕様に合わせ、カレンダーの枠内のマスを指定
    cells = driver.find_elements(By.CSS_SELECTOR, "table td")[:25]
    
    print(f"--- カレンダー25日分の結果 ---")
    
    for index, cell in enumerate(cells, 1):
        try:
            # マスの中から記事のリンク（aタグ）を探す
            # ユーザー名や日付を弾くため、文字数が長いリンク（タイトル）を狙う
            links = cell.find_elements(By.CSS_SELECTOR, "a[href*='/items/']")
            
            article_link = None
            for l in links:
                t = l.text.strip()
                if t and not t.isdigit() and not t.startswith('@'):
                    article_link = l
                    break
            
            if article_link:
                print(f"{index}日目: {article_link.text} ({article_link.get_attribute('href')})")
            else:
                # 記事が投稿されていない、または「＋」ボタンだけのマスの場合
                print(f"{index}日目: 記事未投稿")
                
        except Exception:
            print(f"{index}日目: 取得エラー")

finally:
    driver.quit()
