import requests
from bs4 import BeautifulSoup
from pymongo import MongoClient

## 1. MongoDBに保存する関数
def save_data(data):
    client = MongoClient('localhost', 27017)
    db = client.db
    co = db.recall_info
    co.insert_one(data)


## 2. ページのHTMLから全件数をスクレイピングして取得
url_get = "https://www.recall.caa.go.jp/result/index.php?screenkbn=01&category=2"
html = requests.get(url_get)
bsObj = BeautifulSoup(html.text, "html.parser")

page = "10"
# findAll から find_all に修正
for link in bsObj.find_all("p"):
    text = str(link.get_text())
    if "件中" in text:
        page = text.split("件中")[0].strip()


## 3. 欲しい情報をスクレイピングしてMongoDBに保存
url_post = "https://www.recall.caa.go.jp/result/index.php"

# ★ テスト用に、実在するキーワード「トヨタ」を指定してみます
payload = {'search': 'sharp', 'category': '2', 'screenkbn': '01', 'viewCountdden': page}
html = requests.post(url_post, data=payload)
bsObj = BeautifulSoup(html.text, "html.parser")

# findAll から find_all に修正
for row in bsObj.find_all("tr"):
    i = 0
    title = ""
    publicationDate = ""
    startDate = ""
    url = ""
    
    td_tags = row.find_all("td")  # ここも find_all に修正
    if not td_tags:
        continue
        
    for link_info in td_tags:
        p_tag = link_info.find("p")
        if p_tag and p_tag.find("a"):
            a_tag = p_tag.find("a")
            if a_tag.has_attr('href'):
                url = "https://www.recall.caa.go.jp" + a_tag['href']
                
        text = link_info.get_text().strip()
        
        if i == 2:
            title = text
        if i == 3:
            publicationDate = text
        if i == 4:
            startDate = text
        i += 1
        
    if title:
        data = {
            "title": title,
            "publicationDate": publicationDate,
            "startDate": startDate,
            "url": url
        }
        save_data(data)
        print(f"保存しました: {title}")
